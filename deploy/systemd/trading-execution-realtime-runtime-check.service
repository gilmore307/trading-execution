[Unit]
Description=Refresh execution realtime trading runtime readiness
Documentation=file:/root/projects/trading-execution/docs/40_runtime_model_lifecycle.md
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/root/projects/trading-execution
Environment=PYTHONPATH=/root/projects/trading-execution/src
Environment=TRADING_EXECUTION_RUNTIME_OUTPUT_DIR=/root/projects/trading-storage/storage/04_execution_artifacts/runtime/realtime_trading_runtime
Environment=TRADING_EXECUTION_ACTIVE_MODEL_CONFIG_PATH=/root/projects/trading-storage/storage/04_execution_artifacts/runtime/active_model/latest_active_model_config_write.json
EnvironmentFile=-/etc/default/trading-execution-realtime-runtime-check
ExecStart=/usr/bin/python3 /root/projects/trading-execution/scripts/execution/run_realtime_trading_runtime_check.py \
  --active-model-config-path ${TRADING_EXECUTION_ACTIVE_MODEL_CONFIG_PATH} \
  --output-dir ${TRADING_EXECUTION_RUNTIME_OUTPUT_DIR}
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
