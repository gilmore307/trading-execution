[Unit]
Description=Execution realtime monitor loop
Documentation=file:/root/projects/trading-execution/docs/20_realtime_data.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/root/projects/trading-execution
Environment=PYTHONPATH=/root/projects/trading-execution/src
Environment=TRADING_EXECUTION_REALTIME_MONITOR_SOURCE=alpaca
Environment=TRADING_EXECUTION_REALTIME_MONITOR_MAX_SYMBOLS=44
Environment=TRADING_EXECUTION_REALTIME_MONITOR_INTERVAL_SECONDS=60
Environment=TRADING_EXECUTION_REALTIME_MONITOR_OUTPUT_DIR=/root/projects/trading-storage/storage/04_execution_artifacts/runtime/realtime_monitor
Environment=TRADING_EXECUTION_REALTIME_MONITOR_EXECUTE_LIVE_OBSERVE=
EnvironmentFile=-/etc/default/trading-execution-realtime-monitor-loop
ExecStart=/bin/sh -lc 'exec /usr/bin/python3 /root/projects/trading-execution/scripts/execution/run_realtime_monitor_loop.py \
  --request-prefix realtime_monitor \
  --approval-prefix realtime_monitor \
  --source-id "$TRADING_EXECUTION_REALTIME_MONITOR_SOURCE" \
  --max-symbols "$TRADING_EXECUTION_REALTIME_MONITOR_MAX_SYMBOLS" \
  --cycles 1 \
  --interval-seconds 0 \
  --output-dir "$TRADING_EXECUTION_REALTIME_MONITOR_OUTPUT_DIR/$(date -u +%%Y%%m%%dT%%H%%M%%SZ)" \
  ${TRADING_EXECUTION_REALTIME_MONITOR_EXECUTE_LIVE_OBSERVE:+--execute-live-observe}'
Restart=always
RestartSec=60
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
